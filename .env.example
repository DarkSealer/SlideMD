# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Contact form (api/contact.ts) ---
# Server-side only. Set these in Vercel → Project → Settings → Environment Variables.
# Never prefix them with VITE_, or they would be bundled into the client.

# RESEND_API_KEY: Resend API key. Create it with "Sending access" only.
RESEND_API_KEY="re_xxxxxxxxxxxx"

# CONTACT_TO_EMAIL: The inbox that receives bug reports and messages.
CONTACT_TO_EMAIL="you@example.com"

# CONTACT_FROM_EMAIL (optional): Sender on a domain verified in Resend.
# If unset, Resend's shared sender is used, which only delivers to the
# email address of the Resend account owner.
# CONTACT_FROM_EMAIL="SlideMD <feedback@yourdomain.com>"
